{
  "name": "chuhuiev-denys-home-work-35-webpack-mastery",
  "version": "1.0.0",
  "description": "Homework 35. Webpack mastery with DevServer, CSS preprocessors, TypeScript, Babel, ESLint and Bundle Analyzer.",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack serve --mode development --open",
    "build": "cross-env NODE_ENV=production webpack --mode production",
    "watch": "cross-env NODE_ENV=development webpack --mode development --watch",
    "lint": "eslint src/js --ext .js",
    "analyze": "cross-env NODE_ENV=production webpack --mode production --env analyze=true"
  },
  "author": "Denys Chuhuiev",
  "license": "ISC",
